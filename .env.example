# Database Configuration
DATABASE_URL=postgresql+asyncpg://phishguard:phishguard_password@localhost:5432/phishguard

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Clerk Authentication
CLERK_SECRET_KEY=REPLACE_WITH_YOUR_KEY
CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_KEY

# Extension API Key (shared secret)
EXTENSION_API_KEY=your-secure-extension-key-here

# Threat Intelligence APIs
VIRUSTOTAL_API_KEY=REPLACE_WITH_YOUR_KEY
URLHAUS_API_KEY=
ABUSEIPDB_API_KEY=REPLACE_WITH_YOUR_KEY

# Groq API (for LLM explanations)
GROQ_API_KEY=REPLACE_WITH_YOUR_KEY

# ML Model Path
MODEL_PATH=./backend/app/ml/models/lgbm_v1.pkl

# Sentry (optional)
SENTRY_DSN=

# Frontend Environment Variables
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_KEY
NEXT_PUBLIC_API_URL=http://localhost:8000
